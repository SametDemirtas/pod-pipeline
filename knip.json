{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts", "*.config.{js,ts}"]
    },
    "apps/desktop": {
      "entry": ["src/main/composition/png-worker.ts", "e2e/**/*.e2e.ts"],
      "project": ["src/**/*.ts", "e2e/**/*.ts"]
    },
    "apps/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/mcp": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["vitest"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["lipo"]
}
